# Server environment configuration

# Server port
PORT=3000

# Environment (development, production, test)
ENV=development

# CORS origin (leave empty for default: '*' in dev, 'https://atoyr.com' in prod)
# CORS_ORIGIN=http://localhost:5173

# Database path (relative to server directory)
DATABASE_PATH=db/db.sqlite3
GOOGLE_CLIENT_ID=
ALLOWED_ADMIN_EMAILS=

# Topics directory (relative to server directory)
TOPICS_DIR=topics
