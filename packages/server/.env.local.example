# Server environment configuration

# Server port
PORT=3000

# Environment (development, production, test)
ENV=development

# CORS origin (leave empty for default: '*' in dev, 'https://atoyr.com' in prod)
# CORS_ORIGIN=http://localhost:5173

# Database path (relative to server directory)
DATABASE_PATH=db/db.sqlite3
GOOGLE_CLIENT_ID=
ALLOWED_ADMIN_EMAILS=

# Words data path (relative to server directory)
WORDS_PATH=data/words.json

# AGS (AccelByte Gaming Services)
AGS_BASE_URL=
AGS_NAMESPACE=
AGS_CLIENT_ID=
AGS_CLIENT_SECRET=
AGS_ADMIN_REDIRECT_URI=http://127.0.0.1:8080
AGS_WEB_CLIENT_ID=
