{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "monorepo": true,
  "projects": {
    "shared": {
      "type": "library",
      "root": "../shared",
      "entryFile": "index.ts",
      "sourceRoot": "../shared/src",
      "compilerOptions": {
        "tsConfigPath": "../shared/tsconfig.build.json"
      }
    }
  },
  "compilerOptions": {
    "builder": "swc",
    "deleteOutDir": true,
    "tsConfigPath": "tsconfig.json",
    "webpack": true
  }
}