{
  "name": "@atoyr/server",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "yarn --cwd ../../packages/shared build && nest start --watch",
    "dev:debug": "yarn --cwd ../../packages/shared build && nest start --debug --watch",
    "build": "yarn --cwd ../../packages/shared build && nest build",
    "start": "node dist/server/src/main.js",
    "start:prod": "node dist/server/src/main.js",
    "test": "yarn --cwd ../../packages/shared build && vitest run"
  },
  "dependencies": {
    "@atoyr/shared": "workspace:*",
    "@nestjs/common": "11.1.6",
    "@nestjs/config": "3.1.1",
    "@nestjs/core": "11.1.6",
    "@nestjs/event-emitter": "2.0.4",
    "@nestjs/platform-express": "11.1.6",
    "@nestjs/typeorm": "9.0.1",
    "better-sqlite3": "12.6.2",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "typeorm": "0.3.17",
    "uuid": "9.0.1"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.6",
    "@nestjs/schematics": "11.0.9",
    "@swc/cli": "0.7.10",
    "@swc/core": "1.15.10",
    "@types/eventsource": "1.1.11",
    "@types/express": "5.0.3",
    "@types/node": "20.5.9",
    "@types/supertest": "6.0.2",
    "@types/uuid": "9.0.7",
    "eventsource": "2.0.2",
    "supertest": "6.3.3",
    "ts-loader": "9.5.4",
    "typescript": "5.9.2",
    "vitest": "4.0.8"
  }
}
