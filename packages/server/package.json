{
  "name": "@atoyr/server",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "postinstall": "go mod tidy",
    "dev": "air -c .air.toml",
    "build": "go build -o bin/server ./cmd/main.go",
    "test": "gotestsum -- -short ./...",
    "gen": "go tool oapi-codegen -config api.cfg.yaml api.yaml"
  },
  "description": "Atoyr backend server written in Go with Gin and GORM"
}
