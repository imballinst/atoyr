{
  "name": "server",
  "version": "0.1.2",
  "private": true,
  "description": "Atoyr backend server written in Go with Gin and GORM",
  "scripts": {
    "postinstall": "go mod tidy",
    "dev": "air -c .air.toml",
    "build": "go build -o bin/server ./cmd/service/main.go",
    "test": "gotestsum -- -p 1 -parallel 1 -short -count=1 ./...",
    "bench": "go test -bench=. -run='^$' ./...",
    "codegen": "go tool oapi-codegen -config api.cfg.yaml ./api.yaml"
  }
}
